NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Lokal ishlash uchun (docker-compose.yml):
MONGODB_URI=mongodb://localhost:27017/totli
REDIS_URL=redis://localhost:6379

# Production uchun (docker-compose.prod.yml) — konteyner nomlari va parollar bilan:
# MONGO_ROOT_USER=totli
# MONGO_ROOT_PASSWORD=<uzun-tasodifiy-parol>
# REDIS_PASSWORD=<uzun-tasodifiy-parol>
# MONGODB_URI=mongodb://totli:<parol>@mongodb:27017/totli?authSource=admin
# REDIS_URL=redis://:<parol>@redis:6379

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Barcha yangi buyurtmalar shu guruhga yuboriladi — bir nechta admin bir
# vaqtda ko'rib, tugmalar orqali statusni o'zgartira oladi (faqat Admins
# jadvalida shu odamning telegramId'si ro'yxatda bo'lsa ishlaydi).
# 1) Botni guruhga admin sifatida qo'shing
# 2) Guruhga bir xabar yozing
# 3) https://api.telegram.org/bot<TOKEN>/getUpdates dan chat.id ni oling
#    (odatda -100 bilan boshlanadi)
TELEGRAM_GROUP_ID=-1002451334889
# Guruhdagi pin tugmasi Mini App'ni ochishi uchun (guruhda web_app tugmasi ISHLAMAYDI, url tugma kerak).
# Bo'sh qoldirsangiz: botda Main Mini App yoqilgan bo'lsa https://t.me/<bot>?startapp ishlatiladi,
# yoqilmagan bo'lsa tugma botning shaxsiy chatiga olib boradi (2 bosish).
# Eng yaxshisi — @BotFather da Main Mini App yoqish, yoki /newapp bilan yaratib shu yerga yozish:
# WEBAPP_DIRECT_LINK=https://t.me/<bot_username>/<app_short_name>

# Ixtiyoriy: guruh sozlanmagan hollarda yagona shaxsiy chatga yuborish uchun.
ADMIN_CHAT_ID=
WEBAPP_URL=https://your-domain.com
ADMIN_URL=https://admin.your-domain.com

# Mini App'dagi qo'ng'iroq tugmasi shu raqamga ochiladi (+998 bilan)
CONTACT_PHONE=+998901234567
# TELEGRAM_WEBHOOK_URL=

# Admin panelga kirish. Server ishga tushganda shu hisob avtomatik yaratiladi
# (yoki paroli yangilanadi). Production'da uzunroq parol qo'ying.
ADMIN_LOGIN=totli123
ADMIN_PASSWORD=totli

JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=8h
TELEGRAM_AUTH_MAX_AGE_SEC=86400

# Rasm yuklash. Cloudinary → Dashboard → Product Environment Credentials.
# Bo'sh qoldirilsa admin panelda rasm yuklash ishlamaydi (503 qaytaradi).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend domenlari. Vercel'dagi ikkala loyihani ham qo'shing.
# ---------------------------------------------------------------------------
# Katalog: mahsulotlar va kategoriyalar LokmaGo'dan keladi (MongoDB'da saqlanmaydi).
# MongoDB'da faqat admin qo'lda bergan "taom → kategoriya" tanlovlari turadi.
# ---------------------------------------------------------------------------
LOKMAGO_CATALOG_URL=https://api.lokmago.uz/j/4454/6a5ff4869a705be4489f06b6
# Kesh muddati (soniya). Shuncha vaqtda bir LokmaGo qayta o'qiladi.
LOKMAGO_CACHE_TTL_SEC=180
# Admin kategoriya bergan taom LokmaGo'dan ketma-ket shuncha tekshiruvda kelmasa,
# uning kategoriyasi avtomatik o'chadi. Har muvaffaqiyatli yangilanish = 1 tekshiruv.
CATALOG_MISS_LIMIT=3

CORS_ORIGINS=http://localhost:5173
# CORS_ORIGINS=https://totli-web.vercel.app,https://totli-admin.vercel.app

# Payments (leave empty = NOT_CONFIGURED)
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYNET_MERCHANT_ID=
PAYNET_SECRET_KEY=

# Delivery (UZS)
DELIVERY_BASE_PRICE=15000
DELIVERY_FREE_FROM=500000

# Seed
# SEED_ADMIN_PASSWORD=Admin123!ChangeMe
# SEED_ADMIN_TELEGRAM_ID=
